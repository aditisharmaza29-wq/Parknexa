/* ============================================================
   ParkNexa – Application Stylesheet
   Modern dark-navy sidebar + light grey content area
   ============================================================ */

/* ── Global ───────────────────────────────────────────────── */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #2C3E50;
}

QMainWindow, QDialog {
    background-color: #F0F2F5;
}

/* ── Sidebar ──────────────────────────────────────────────── */
#sidebar {
    background-color: #1A2744;
    min-width: 220px;
    max-width: 220px;
}

#appTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    padding: 24px 16px 8px 16px;
}

#appSubtitle {
    color: #8FA3C1;
    font-size: 11px;
    padding: 0px 16px 20px 16px;
}

/* Sidebar nav buttons */
#navButton {
    background-color: transparent;
    color: #B0C4DE;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 10px;
}

#navButton:hover {
    background-color: #243358;
    color: #FFFFFF;
}

#navButton[active="true"] {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: bold;
}

/* Sidebar user info panel */
#userPanel {
    background-color: #243358;
    border-radius: 10px;
    margin: 10px;
    padding: 10px;
}

#userNameLabel {
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}

#userRoleLabel {
    color: #8FA3C1;
    font-size: 11px;
}

/* Logout button in sidebar */
#logoutButton {
    background-color: transparent;
    color: #E74C3C;
    border: 1px solid #E74C3C;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    margin: 8px 10px;
}

#logoutButton:hover {
    background-color: #E74C3C;
    color: #FFFFFF;
}

/* ── Content area ─────────────────────────────────────────── */
#contentArea {
    background-color: #F0F2F5;
}

/* ── Page header ──────────────────────────────────────────── */
#pageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #1A2744;
}

#pageSubtitle {
    font-size: 12px;
    color: #7F8C8D;
}

/* ── Stat cards (Dashboard) ───────────────────────────────── */
#statCard {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #E8ECF0;
    padding: 20px;
}

#statValue {
    font-size: 32px;
    font-weight: bold;
    color: #1A2744;
}

#statLabel {
    font-size: 12px;
    color: #7F8C8D;
    font-weight: 500;
}

#statIcon {
    font-size: 24px;
}

/* ── Parking slot cards ────────────────────────────────────── */
#slotCard {
    border-radius: 10px;
    padding: 12px;
    border: 2px solid transparent;
    min-width: 100px;
    max-width: 120px;
    min-height: 90px;
}

#slotCard[status="free"] {
    background-color: #EAFAF1;
    border-color: #27AE60;
}

#slotCard[status="occupied"] {
    background-color: #FDEDEC;
    border-color: #E74C3C;
}

#slotCard[status="reserved"] {
    background-color: #FEF9E7;
    border-color: #F39C12;
}

#slotId {
    font-weight: bold;
    font-size: 14px;
    color: #2C3E50;
}

#slotStatusLabel[status="free"]     { color: #27AE60; font-weight: bold; font-size: 11px; }
#slotStatusLabel[status="occupied"] { color: #E74C3C; font-weight: bold; font-size: 11px; }
#slotStatusLabel[status="reserved"] { color: #F39C12; font-weight: bold; font-size: 11px; }

#slotMeta { color: #7F8C8D; font-size: 10px; }

/* ── Primary buttons ──────────────────────────────────────── */
QPushButton#primaryBtn {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#primaryBtn:hover {
    background-color: #1D4ED8;
}

QPushButton#primaryBtn:pressed {
    background-color: #1E40AF;
}

QPushButton#primaryBtn:disabled {
    background-color: #9CA3AF;
}

/* ── Secondary buttons ────────────────────────────────────── */
QPushButton#secondaryBtn {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 2px solid #2563EB;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#secondaryBtn:hover {
    background-color: #EFF6FF;
}

/* ── Danger buttons ───────────────────────────────────────── */
QPushButton#dangerBtn {
    background-color: #E74C3C;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton#dangerBtn:hover {
    background-color: #C0392B;
}

/* ── Success buttons ──────────────────────────────────────── */
QPushButton#successBtn {
    background-color: #27AE60;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton#successBtn:hover {
    background-color: #229954;
}

/* ── Input fields ─────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #2C3E50;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #2563EB;
    outline: none;
}

QLineEdit:read-only {
    background-color: #F9FAFB;
    color: #6B7280;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #2563EB;
}

/* ── Labels ───────────────────────────────────────────────── */
QLabel#formLabel {
    font-weight: 600;
    color: #374151;
    font-size: 12px;
}

QLabel#errorLabel {
    color: #E74C3C;
    font-size: 12px;
    font-weight: 500;
}

QLabel#successMsg {
    color: #27AE60;
    font-size: 12px;
    font-weight: 500;
}

/* ── Cards / Panels ───────────────────────────────────────── */
#card {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #E8ECF0;
    padding: 20px;
}

/* ── Tables ───────────────────────────────────────────────── */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 8px;
    gridline-color: #F3F4F6;
    alternate-background-color: #F9FAFB;
    selection-background-color: #EFF6FF;
    selection-color: #2C3E50;
}

QTableWidget::item {
    padding: 8px 12px;
    border: none;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #6B7280;
    font-weight: bold;
    font-size: 11px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E8ECF0;
    text-transform: uppercase;
}

/* ── Scroll bars ──────────────────────────────────────────── */
QScrollBar:vertical {
    background: #F3F4F6;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
    background: #F3F4F6;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover { background: #9CA3AF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* ── Login screen ─────────────────────────────────────────── */
#loginContainer {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E8ECF0;
    padding: 40px;
    min-width: 380px;
    max-width: 420px;
}

#loginLogo {
    font-size: 36px;
    font-weight: bold;
    color: #1A2744;
    letter-spacing: 2px;
}

#loginSubtitle {
    color: #7F8C8D;
    font-size: 13px;
}

#loginTab {
    background-color: #F3F4F6;
    border-radius: 8px;
    padding: 4px;
}

/* ── Message box ──────────────────────────────────────────── */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 6px 16px;
    min-width: 70px;
}

QMessageBox QPushButton:hover { background-color: #1D4ED8; }

/* ── Separator ────────────────────────────────────────────── */
#separator {
    background-color: #2D3E5A;
    max-height: 1px;
    min-height: 1px;
}

/* ── Badge / Chip ─────────────────────────────────────────── */
#badge {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: bold;
}

#badge[color="green"] { background: #EAFAF1; color: #27AE60; }
#badge[color="red"]   { background: #FDEDEC; color: #E74C3C; }
#badge[color="orange"]{ background: #FEF9E7; color: #F39C12; }
#badge[color="blue"]  { background: #EFF6FF; color: #2563EB; }

/* ── Map/graph canvas ─────────────────────────────────────── */
#mapView {
    background-color: #1A2744;
    border-radius: 12px;
    border: 1px solid #2D3E5A;
}

/* ── Group box ────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #E8ECF0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1A2744;
    font-weight: bold;
    font-size: 13px;
}

/* ── Tab widget (used in login) ───────────────────────────── */
QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    background: #F3F4F6;
    border: none;
    border-radius: 6px;
    padding: 8px 24px;
    margin: 2px;
    color: #6B7280;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #2563EB;
    font-weight: bold;
    border-bottom: 3px solid #2563EB;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #E8ECF0;
    width: 1px;
}
